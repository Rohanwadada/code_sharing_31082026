 <!-- TOOD: Need to update this -->

<!DOCTYPE html>
<html>
  <body style="margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif;">
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f5f7fa; padding: 40px 0;"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="600"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="background-color: #ffffff; border-radius: 10px; overflow: hidden;"
          >
            <!-- Brand Header -->
            <tr>
              <td style="background-color: #000000; text-align: center; padding: 20px;">
                <img
                  src="https://roadmap.setuschool.com/setu-logo.png"
                  alt="SETU Logo"
                  width="50"
                  style="display: inline-block;"
                />
              </td>
            </tr>

            <!-- Header -->
            <tr>
              <td style="padding: 30px 30px 20px; text-align: center;">
                <h2 style="margin: 0; font-size: 24px; color: #333333;">
                  Your Assessment Is Ready
                </h2>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 0 30px 30px; font-size: 16px; color: #555555; line-height: 1.6;">
                <p style="margin: 0 0 16px;">
                  Hi Learner,
                </p>

                <p style="margin: 0 0 16px;">
                  You have been invited to take the
                  <strong>{{ assessment_name }}</strong> assessment.
                </p>

                <p style="margin: 0 0 30px;">
                  Please click the button below to access your assessment and get started.
                </p>

                <!-- CTA Button -->
                <div style="text-align: center; margin: 30px 0;">
                  <a
                    href="{{ assessment_url }}"
                    style="background-color: #ffc728; color: #000000 !important; text-decoration: none; padding: 12px 24px; border-radius: 6px; display: inline-block; font-weight: bold;"
                  >
                    Start Assessment
                  </a>
                </div>

                <p style="margin: 30px 0 0;">
                  Good luck, and we hope you have a great experience!
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="padding: 30px; background-color: #f0f0f0; font-size: 14px; color: #666666; text-align: center;"
              >
                <p style="margin: 0 0 8px;">
                  Need help? We're here for you.
                </p>

                <p style="margin: 0;">
                  Contact our support team at
                  <a
                    href="mailto:mitra@setuschool.com"
                    style="color: #f7cf02; text-decoration: none;"
                  >
                    mitra@setuschool.com
                  </a>
                </p>

                <p style="margin: 8px 0 0;">
                  © 2026 SETU. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
