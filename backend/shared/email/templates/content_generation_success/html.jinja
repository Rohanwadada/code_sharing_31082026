<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Shifu Notification</title>
  </head>

  <body style="margin:0;padding:0;background:#0b0f14;">

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0b0f14;">
      <tr>
        <td align="center" style="padding:28px 12px;">

          <table role="presentation"
                 width="100%"
                 cellspacing="0"
                 cellpadding="0"
                 border="0"
                 style="max-width:640px;border-radius:16px;overflow:hidden;background:#101826;border:1px solid rgba(255,255,255,0.08);">

            <!-- Header -->
            <tr>
              <td align="center"
                  style="padding:22px 20px;background:linear-gradient(180deg,#0f1724 0%, #101826 100%);">

                <img
                  src="https://roadmap.setuschool.com/setu-logo.png"
                  alt="SETU"
                  width="44"
                  style="display:block;border:0;outline:none;text-decoration:none;"
                />

                <div style="height:12px;line-height:12px;">&nbsp;</div>

                <div
                  style="font-family:Arial,Helvetica,sans-serif;font-size:14px;letter-spacing:0.2px;color:rgba(255,255,255,0.72);">
                  Shifu Learning Coach
                </div>

              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:26px 22px 18px 22px;font-family:Arial,Helvetica,sans-serif;">

                <div style="font-size:18px;line-height:26px;color:#ffffff;font-weight:700;">
                  Update ready for
                  <span style="color:#ffc728;">
                    {{ roadmap_name | default("your roadmap", true) }}
                  </span>
                </div>

                <div style="height:10px;line-height:10px;">&nbsp;</div>

                <!--
                    content contains HTML (<strong>, <br>, etc.)
                    so render it safely.
                -->
                <div
                  style="font-size:14px;line-height:22px;color:rgba(255,255,255,0.78);">
                  {{ content | safe }}
                </div>

                <div style="height:18px;line-height:18px;">&nbsp;</div>

                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td bgcolor="#ffc728" style="border-radius:10px;">

                      <a href="{{ roadmap_url | default('#', true) }}"
                         target="_blank"
                         style="display:inline-block;padding:12px 18px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;text-decoration:none;color:#0b0f14;border-radius:10px;">

                        Open in Shifu

                      </a>

                    </td>
                  </tr>
                </table>

                <div style="height:14px;line-height:14px;">&nbsp;</div>

              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding:0 22px;">
                <div style="height:1px;background:rgba(255,255,255,0.08);line-height:1px;">&nbsp;</div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:16px 22px 22px 22px;font-family:Arial,Helvetica,sans-serif;">

                <div style="font-size:12px;line-height:18px;color:rgba(255,255,255,0.6);">

                  Need help? Contact us at

                  <a href="mailto:{{ support_email }}"
                     style="color:#ffc728;text-decoration:none;">
                    {{ support_email }}
                  </a>

                  or call

                  <a href="tel:{{ support_phone_tel }}"
                     style="color:#ffc728;text-decoration:none;">
                    {{ support_phone_display }}
                  </a>.

                </div>

                <div style="height:8px;line-height:8px;">&nbsp;</div>

                <div style="font-size:12px;line-height:18px;color:rgba(255,255,255,0.45);">
                  © 2026 SETU. All rights reserved.
                </div>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>