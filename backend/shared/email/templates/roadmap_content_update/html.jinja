<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;background-color:#f5f7fa;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f5f7fa;padding:40px 0;">
        <tr style="page-break-inside: avoid;">
            <td align="center">
                <table role="presentation" width="700" cellspacing="0" cellpadding="0" border="0" style="background-color:#ffffff;border-radius:10px;overflow:hidden;page-break-inside: auto;">

                    <tr style="page-break-inside: avoid;">
                        <td style="background-color:#000000;text-align:center;padding:20px;">
                            <img src="https://roadmap.setuschool.com/setu-logo.png" alt="SETU Logo" width="50" />
                        </td>
                    </tr>

                    <tr style="page-break-inside: avoid;">
                        <td style="padding:30px;text-align:center;">
                            <h2 style="margin:0;font-size:24px;color:#333333;">New Content Alert! 🎯</h2>
                        </td>
                    </tr>

                    <tr style="page-break-inside: avoid;">
                        <td style="padding:0 30px 30px 30px;font-size:16px;color:#333333;">

                            <p>Hi Learner,</p>

                            <p>
                                We've added <strong>new content</strong> to the
                                <strong>{{ roadmap_name }}</strong> roadmap!
                            </p>

                            <p>The following section(s) have been updated:</p>

                            <table width="100%" cellspacing="0" cellpadding="0" border="0"
                                   style="border-collapse:collapse;width:100%;min-width:600px;font-size:14px;color:#000000;page-break-inside:auto;">

                                <thead>
                                    <tr style="page-break-inside: avoid;">
                                        <th style="border:1px solid #a5a5a5;padding:10px 12px;text-align:center;min-width:180px;background-color:#f5f5f5;font-weight:600;">
                                            Module / Topic Title
                                        </th>

                                        <th style="border:1px solid #a5a5a5;padding:10px 12px;text-align:center;min-width:180px;background-color:#f5f5f5;font-weight:600;">
                                            Materials
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                {% for nd in node_details %}

                                    <tr style="page-break-inside: avoid;">

                                        <td style="border:1px solid #a5a5a5;padding:10px 12px;font-weight:500;min-width:180px;">
                                            {{ nd.parentTitle | default("-", true) }}
                                        </td>

                                        <td style="border:1px solid #a5a5a5;padding:0;min-width:180px;">

                                            <table width="100%"
                                                   cellspacing="0"
                                                   cellpadding="0"
                                                   border="0"
                                                   style="border-collapse:collapse;table-layout:fixed;width:100%;min-width:600px;page-break-inside:auto;">

                                                {% if loop.first %}
                                                <thead>
                                                    <tr style="page-break-inside: avoid;">
                                                        <th style="border:1px solid #a5a5a5;padding:10px 12px;text-align:center;min-width:180px;background-color:#f5f5f5;font-weight:600;">
                                                            Chapter Name
                                                        </th>

                                                        <th style="border:1px solid #a5a5a5;padding:10px 12px;text-align:center;min-width:180px;background-color:#f5f5f5;font-weight:600;">
                                                            Content Name
                                                        </th>
                                                    </tr>
                                                </thead>
                                                {% endif %}

                                                <tbody>

                                                {% for cd in nd.childDetails %}

                                                    <tr style="page-break-inside: avoid;">

                                                        <td style="border:1px solid #a5a5a5;padding:10px 12px;font-weight:500;min-width:180px;">

                                                            {{ cd.title }}

                                                            <a href="{{ roadmap_url }}?node={{ cd.id }}"
                                                               target="_blank">

                                                                <img src="https://img.icons8.com/?size=512&id=hUqP035cA2Bd&format=png"
                                                                     width="14"
                                                                     height="14"
                                                                     style="display:inline-block;" />

                                                            </a>

                                                        </td>

                                                        <td style="border:1px solid #a5a5a5;padding:10px 12px 10px 0;font-weight:500;min-width:180px;">

                                                            <ol style="padding-left:12px;margin:0;list-style-position:outside;">

                                                                {% for content in cd.content|sort(attribute='id') %}

                                                                    <li style="margin-bottom:5px;margin-left:15px;">
                                                                        {{ content.title }}
                                                                    </li>

                                                                {% endfor %}

                                                            </ol>

                                                        </td>

                                                    </tr>

                                                {% endfor %}

                                                </tbody>

                                            </table>

                                        </td>

                                    </tr>

                                {% endfor %}

                                </tbody>

                            </table>

                            <p style="margin:30px 0;">
                                Dive in and start exploring the new resources now!
                            </p>

                            <div style="text-align:center;">

                                <a href="{{ roadmap_url }}"
                                   style="background-color:#ffc728;color:#000;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:bold;display:inline-block;">

                                    Go to Roadmap

                                </a>

                            </div>

                        </td>
                    </tr>

                    <tr style="page-break-inside: avoid;">
                        <td style="padding:30px;background-color:#f0f0f0;font-size:14px;color:#666666;text-align:center;">

                            <p style="margin:0 0 8px;">
                                Need help? We're here for you.
                            </p>

                            <p style="margin:0;">
                                Contact our support team at
                                <a href="mailto:mitra@setuschool.com"
                                   style="color:#f7cf02;text-decoration:none;">
                                    mitra@setuschool.com
                                </a>
                            </p>

                            <p>© 2026 SETU. All rights reserved.</p>

                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>