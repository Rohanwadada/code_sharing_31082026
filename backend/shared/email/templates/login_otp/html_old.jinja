<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>Your OTP Code</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    /* Reset */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { margin: 0; padding: 0; width: 100% !important; height: 100% !important; }
    table { border-collapse: collapse; }

    /* Responsive */
    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; max-width: 100% !important; }
      .mobile-pad { padding: 24px 20px !important; }
      .otp-box { font-size: 32px !important; letter-spacing: 10px !important; padding: 14px 20px !important; }
      .logo-wrap { text-align: center !important; }
      .brand-name { font-size: 20px !important; }
      .footer-text { text-align: center !important; }
      .stack { display: block !important; width: 100% !important; }
      .spacer { height: 8px !important; }
    }
    @media (prefers-color-scheme: dark) {
      .dark-bg { background-color: #1a1a2e !important; }
      .dark-card { background-color: #16213e !important; }
      .dark-text { color: #e0e0e0 !important; }
      .dark-heading { color: #ffffff !important; }
      .dark-mute { color: #a0a0b0 !important; }
      .dark-border { border-color: #2a2a4a !important; }
      .otp-dark-bg { background-color: #0f3460 !important; border-color: #1a5276 !important; }
      .otp-dark-text { color: #ffffff !important; }
      .hero-dark-bg { background: linear-gradient(135deg, #0f3460, #1a1a2e) !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f6f9;">
    <tr>
      <td align="center" style="padding: 0;">
        <!--[if mso]>
        <table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0"><tr><td>
        <![endif]-->

        <!-- Main Container -->
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; margin: 0 auto;">

          <!-- Header / Brand -->
          <tr>
            <td class="dark-bg" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border-radius: 16px 16px 0 0; padding: 32px 40px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="logo-wrap" style="vertical-align: middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" style="display: inline-block;">
                      <tr>
                        <td style="vertical-align: middle; padding-right: 12px;">
                          <!-- Brand Logo Placeholder -->
                          <table role="presentation" cellpadding="0" cellspacing="0" style="width: 44px; height: 44px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; text-align: center;">
                            <tr>
                              <td style="font-size: 22px; font-weight: 700; color: #ffffff; text-align: center; vertical-align: middle; line-height: 44px;">S</td>
                            </tr>
                          </table>
                        </td>
                        <td style="vertical-align: middle;">
                          <span class="brand-name" style="font-size: 22px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px;">SETU</span>
                          <span style="font-size: 22px; font-weight: 300; color: #8899dd; letter-spacing: -0.5px;">LMS</span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body Card -->
          <tr>
            <td class="dark-card mobile-pad" style="background-color: #ffffff; padding: 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">

                <!-- Greeting -->
                <tr>
                  <td class="dark-heading" style="font-size: 24px; font-weight: 700; color: #1a1a2e; margin-bottom: 8px;">Welcome back</td>
                </tr>
                <tr>
                  <td style="height: 8px;"></td>
                </tr>
                <tr>
                  <td class="dark-text" style="font-size: 15px; line-height: 24px; color: #4a4a6a;">
                    Use the one-time passcode below to complete your login or verify your identity for first-time access.
                  </td>
                </tr>

                <!-- Divider -->
                <tr>
                  <td style="height: 28px;"></td>
                </tr>
                <tr>
                  <td style="border-top: 1px solid #e8e8f0;"></td>
                </tr>
                <tr>
                  <td style="height: 28px;"></td>
                </tr>

                <!-- OTP Section -->
                <tr>
                  <td align="center">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td class="dark-mute" style="font-size: 13px; font-weight: 600; color: #8888aa; text-transform: uppercase; letter-spacing: 2px; text-align: center; padding-bottom: 14px;">
                          One-Time Passcode
                        </td>
                      </tr>
                      <tr>
                        <td align="center">
                          <!--[if mso]>
                          <table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 16px; padding: 18px 36px;">
                          <![endif]-->
                          <div class="otp-box" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 16px; padding: 18px 36px; text-align: center; box-shadow: 0 8px 24px rgba(102, 126, 234, 0.25);">
                            <span style="font-size: 40px; font-weight: 800; color: #ffffff; letter-spacing: 12px; font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', 'Courier New', monospace; -webkit-font-smoothing: antialiased;">{{ otp }}</span>
                          </div>
                          <!--[if mso]>
                          </td></tr></table>
                          <![endif]-->
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Expiry Note -->
                <tr>
                  <td style="height: 20px;"></td>
                </tr>
                <tr>
                  <td class="dark-mute" style="font-size: 13px; line-height: 20px; color: #8888aa; text-align: center;">
                    This code expires in a few minutes. Never share this code with anyone.
                  </td>
                </tr>

                <!-- Divider -->
                <tr>
                  <td style="height: 28px;"></td>
                </tr>
                <tr>
                  <td style="border-top: 1px solid #e8e8f0;"></td>
                </tr>
                <tr>
                  <td style="height: 24px;"></td>
                </tr>

                <!-- Security Note -->
                <tr>
                  <td>
                    <table role="presentation" cellpadding="16" cellspacing="0" style="background-color: #f8f9ff; border-radius: 12px; width: 100%;">
                      <tr>
                        <td>
                          <table role="presentation" cellpadding="0" cellspacing="0">
                            <tr>
                              <td style="font-size: 14px; vertical-align: top; padding-right: 10px; width: 24px;">
                                <span style="display: inline-block; width: 20px; height: 20px; background: #667eea; border-radius: 50%; color: #fff; text-align: center; line-height: 20px; font-size: 12px; font-weight: 700;">&#9432;</span>
                              </td>
                              <td class="dark-text" style="font-size: 13px; line-height: 20px; color: #4a4a6a;">
                                <strong style="color: #1a1a2e;">Didn't request this?</strong> If you didn't request this code, you can safely ignore this email. Someone may have entered your email address by mistake.
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="dark-bg" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border-radius: 0 0 16px 16px; padding: 24px 40px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="footer-text" style="font-size: 13px; color: #8899dd; line-height: 22px;">
                    <strong style="color: #ffffff;">SETU LMS</strong><br>
                    Empowering learning, everywhere.
                  </td>
                </tr>
                <tr>
                  <td style="height: 14px;"></td>
                </tr>
                <tr>
                  <td class="footer-text" style="font-size: 12px; color: #6670aa; line-height: 20px;">
                    Need help? Contact us at
                    <a href="mailto:mitra@setuschool.com" style="color: #8899dd; text-decoration: underline; font-weight: 500;">mitra@setuschool.com</a>
                  </td>
                </tr>
                <tr>
                  <td style="height: 6px;"></td>
                </tr>
                <tr>
                  <td style="border-top: 1px solid rgba(255,255,255,0.08); margin: 10px 0;"></td>
                </tr>
                <tr>
                  <td style="height: 6px;"></td>
                </tr>
                <tr>
                  <td class="footer-text" style="font-size: 11px; color: #5555aa; line-height: 18px;">
                    &copy; 2025 SETU LMS. All rights reserved.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Spacer for dark mode email clients -->
          <tr>
            <td style="height: 16px;"></td>
          </tr>
        </table>

        <!--[if mso]>
        </td></tr></table>
        <![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>