# Use only the official registry
registry=https://registry.npmjs.org/

# Save exact versions (no ^ or ~)
save-exact=true
save-prefix=

# Always create/update package-lock.json
package-lock=true

# Strict dependency validation
strict-peer-deps=true
engine-strict=false

# Security
audit=true
audit-level=high

# Prevent lifecycle scripts from running automatically
ignore-scripts=true

# Reduce unnecessary network traffic
fund=false
update-notifier=false

# Improve reproducibility
prefer-offline=true

# Secure networking
strict-ssl=true

# Retry behavior
fetch-retries=2

# Require packages to be at least 7 days old
min-release-age=7
